PORT=4080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=plugin_data_dashboard
# Supported URI fallback names (if MONGODB_URI is absent):
# NEXT_PUBLIC_MONGODB_URI_TOOLS=
# NEXT_PUBLIC_MONGODB_URI=
# MONGO_URI=
# MONGO_URL=
# Required for Credits and Recent Activity. Use a server-only, read-only user.
BACKEND_MONGODB_URI=mongodb://127.0.0.1:27017
BACKEND_MONGODB_DB=waysorted
# Optional collection overrides:
# BACKEND_USERS_COLLECTION=users
# BACKEND_USER_BILLING_COLLECTION=userbillings
# BACKEND_CREDIT_LEDGER_COLLECTION=creditledgers
# BACKEND_SESSIONS_COLLECTION=sessions
# BACKEND_USAGE_RESERVATIONS_COLLECTION=usagereservations
# BACKEND_STARTER_GRANTS_COLLECTION=startergrants
# BACKEND_PURCHASES_COLLECTION=purchases
# BACKEND_SUBSCRIPTIONS_COLLECTION=subscriptions
# BACKEND_REFUNDS_COLLECTION=refunds
# BACKEND_FEEDBACK_COLLECTION=feedback
# BACKEND_FEEDBACKS_COLLECTION=feedbacks
# BACKEND_FEATURE_REQUESTS_COLLECTION=featurerequests
# BACKEND_TOOLS_COLLECTION=tools
CREDIT_LOW_THRESHOLD=20
ANALYTICS_INGEST_TOKEN=
# Set true only if you want to strictly require x-plugin-ingest-token.
ANALYTICS_INGEST_TOKEN_REQUIRED=false
# Semantic telemetry sessions validate the user's existing Waysorted access token.
WAYSORTED_API_URL=https://www.waysorted.com
# Public website origin used when generating attribution links.
WAYSORTED_PUBLIC_URL=https://www.waysorted.com
WAYSORTED_ANALYTICS_PROFILE_PATH=/api/user/profile
ANALYTICS_SIGNING_SECRET=
ANALYTICS_SESSION_TTL_SECONDS=900
# Recommended: lock all dashboard UI/API read endpoints
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=
# Comma-separated additional usernames that use the same dashboard password.
DASHBOARD_ADMIN_EMAILS=anshbhatt140@gmail.com

# Unified newsletter admin integration (server-side only)
NEWSLETTER_API_URL=https://newsletter-app-waysorted.azurewebsites.net
NEWSLETTER_MANAGEMENT_TOKEN=
NEWSLETTER_PROXY_TIMEOUT_MS=15000
