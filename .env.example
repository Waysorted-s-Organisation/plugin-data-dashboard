PORT=4080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=plugin_data_dashboard
# Supported URI fallback names (if MONGODB_URI is absent):
# NEXT_PUBLIC_MONGODB_URI_TOOLS=
# NEXT_PUBLIC_MONGODB_URI=
# MONGO_URI=
# MONGO_URL=
# Required for Credits and Recent Activity. Use a server-only, read-only user.
BACKEND_MONGODB_URI=mongodb://127.0.0.1:27017
BACKEND_MONGODB_DB=waysorted
# Optional collection overrides:
# BACKEND_USERS_COLLECTION=users
# BACKEND_USER_BILLING_COLLECTION=userbillings
# BACKEND_CREDIT_LEDGER_COLLECTION=creditledgers
# BACKEND_SESSIONS_COLLECTION=sessions
# BACKEND_USAGE_RESERVATIONS_COLLECTION=usagereservations
# BACKEND_STARTER_GRANTS_COLLECTION=startergrants
# BACKEND_PURCHASES_COLLECTION=purchases
# BACKEND_SUBSCRIPTIONS_COLLECTION=subscriptions
# BACKEND_REFUNDS_COLLECTION=refunds
# BACKEND_FEEDBACK_COLLECTION=feedback
# BACKEND_FEEDBACKS_COLLECTION=feedbacks
# BACKEND_FEATURE_REQUESTS_COLLECTION=featurerequests
# BACKEND_TOOLS_COLLECTION=tools
CREDIT_LOW_THRESHOLD=20

# Persist repetitive, information-free plugin traffic (heartbeats, transport
# config changes). Off by default: these never count toward any metric, so
# storing a heartbeat every 30s per open plugin only grows the collection.
# Turn on temporarily when debugging a plugin build.
# ANALYTICS_STORE_PASSIVE_EVENTS=false

# Timezone used to decide which calendar day an event belongs to. Defaults to
# UTC so existing numbers do not shift without an explicit decision. Set it to
# the timezone your users actually live in (e.g. Asia/Kolkata), otherwise
# evening activity in a positive-offset zone is attributed to the previous day
# and two genuine visits can collapse into one.
# REPORTING_TIMEZONE=Asia/Kolkata

# How far back plugin activity is aggregated for cohort retention. Window-scoped
# metrics derive their own exact range; this only bounds the lifetime lookup.
# ANALYTICS_ACTIVITY_LOOKBACK_DAYS=400

# Ceiling on any single plugin-telemetry aggregation, in milliseconds. Defaults
# to 20000. Each aggregation has a defined behaviour for "could not read this" —
# activity reports itself unavailable rather than asserting zero — so losing one
# is survivable, while the serverless function running out of time is not.
# ANALYTICS_AGGREGATION_TIMEOUT_MS=20000
ANALYTICS_INGEST_TOKEN=
# Set true only if you want to strictly require x-plugin-ingest-token.
ANALYTICS_INGEST_TOKEN_REQUIRED=false
# Semantic telemetry sessions validate the user's existing Waysorted access token.
WAYSORTED_API_URL=https://www.waysorted.com
WAYSORTED_ANALYTICS_PROFILE_PATH=/api/user/profile
ANALYTICS_SIGNING_SECRET=
ANALYTICS_SESSION_TTL_SECONDS=900
# REQUIRED. The dashboard, every operations API and the newsletter proxy refuse
# to serve (503) until both of these are set. There is no unauthenticated mode
# for a deployment; `npm run dev` sets ALLOW_UNAUTHENTICATED=true for local work,
# and that variable is deliberately not defined here so copying this file onto a
# server cannot carry the escape hatch with it.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=

# Unified newsletter admin integration (server-side only)
NEWSLETTER_API_URL=https://newsletter-app-waysorted.azurewebsites.net
NEWSLETTER_MANAGEMENT_TOKEN=
NEWSLETTER_PROXY_TIMEOUT_MS=15000
